flowchart TD
    PS(["Pocket Sand<br/>(active)"]):::active
    PSCD["Reduce CD"]:::minor
    PSCaster["Affects casters"]:::minor
    PSAuto["Auto-Backstab on blind<br/>(bridge)"]:::bridge

    SB(["Smoke Bomb<br/>(active)"]):::active
    SBMiss["+Miss %"]:::minor
    SBCaster["Affects casters"]:::minor
    SBThreat["Threat dump on use"]:::minor

    Unseen["Slip the Eye<br/>(cluster — threat reduction)"]:::cluster
    UnMore["+Threat reduction"]:::minor
    UnDmg["+Dmg when unfocused"]:::minor
    UnStealth["Stay stealth +1 turn<br/>(bridge)"]:::bridge

    PS --- PSCD
    PS --- PSCaster
    PS --- PSAuto
    PS --> SB
    SB --- SBMiss
    SB --- SBCaster
    SB --- SBThreat
    SB --> Unseen
    Unseen --- UnMore
    Unseen --- UnDmg
    Unseen --- UnStealth

    OutBackstab["→ to RIGHT (Opportunist):<br/>blind → backstab"]:::out
    OutVanish["→ to CENTER (Vanish):<br/>stealth chain"]:::out
    OutVenom["→ to Venomancer tree:<br/>blind also poisons"]:::out

    PSAuto -. " feeds Backstab " .-> OutBackstab
    UnStealth -. " gates on Vanish " .-> OutVanish
    SB -. " edge bridge " .-> OutVenom

    classDef active fill:#5b3b6a,stroke:#a78bfa,stroke-width:3px,color:#fff
    classDef cluster fill:#2e4a6e,stroke:#5b9bd5,stroke-width:2px,color:#fff
    classDef minor fill:#1a1a2a,stroke:#555,stroke-width:1px,color:#aaa
    classDef bridge fill:#3a2a1a,stroke:#daa520,stroke-width:1px,color:#fcd
    classDef out fill:none,stroke:#666,stroke-dasharray:3 3,color:#999
