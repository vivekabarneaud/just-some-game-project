flowchart TD
    Flurry["The Flurry<br/>(cluster — combo attacks)"]:::cluster
    FlRate["+Combo rate"]:::minor
    FlRate2["+More combo rate"]:::minor
    FlCaster["+Combo vs casters<br/>(bridge)"]:::bridge
    FlStun["+Combo vs stunned<br/>(bridge)"]:::bridge

    Backstab["Opportunist<br/>(cluster — Backstab passive)"]:::cluster
    BSDmg["+Backstab dmg"]:::minor
    BSCrit["+Backstab crit"]:::minor

    SI["Hunter's Eye<br/>(cluster — Shadow Instinct:<br/>auto-target backline casters)"]:::cluster
    SICrit["+Crit vs casters"]:::minor

    TC(["Throat Crush<br/>(active)"]):::active
    TCCD["Reduce CD"]:::minor
    TCDmg["+Dmg"]:::minor
    TCAuto["Passive proc vs casters"]:::minor

    DF["No Honor<br/>(endgame — Dirty Fighting:<br/>chance for extra turn)"]:::cluster
