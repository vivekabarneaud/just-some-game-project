flowchart TD
    Ambush(["Ambush<br/>(active)"]):::active
    AmbStun["Stun on crit"]:::minor
    AmbStun2["+Stun rate"]:::minor
    AmbCrit["+Crit vs healthy<br/>(target &gt;80% HP)"]:::minor
    AmbCrit2["Threshold 70%"]:::minor
    AmbCrit3["Threshold 60%"]:::minor

    Vanish(["Vanish<br/>(active)"]):::active
    VanCD["Reduce CD"]:::minor

    EW["Exploit Weakness<br/>(cluster — armor ignore)"]:::cluster
    EWBase["+Base ignore %"]:::minor
    EWCrit["+Ignore on crit"]:::minor
    EWStun["+Ignore vs stunned<br/>(bridge)"]:::bridge
    EWAmb["+Ignore on Ambush<br/>(bridge)"]:::bridge

    Ambush --- AmbStun
    AmbStun --- AmbStun2
    Ambush --- AmbCrit
    AmbCrit --- AmbCrit2
    AmbCrit2 --- AmbCrit3
    Ambush --> Vanish
    Vanish --- VanCD
    Ambush --> EW
    EW --- EWBase
    EW --- EWCrit
    EW --- EWStun
    EW --- EWAmb

    OutFlurry["→ to RIGHT (The Flurry):<br/>stun synergy"]:::out
    OutSlip["→ to LEFT (Slip the Eye):<br/>stealth chain"]:::out
    EWStun -. " stun feeds " .-> OutFlurry
    AmbStun -. " stun feeds " .-> OutFlurry
    Vanish -. " stay stealth +1 " .-> OutSlip

    classDef active fill:#5b3b6a,stroke:#a78bfa,stroke-width:3px,color:#fff
    classDef cluster fill:#2e4a6e,stroke:#5b9bd5,stroke-width:2px,color:#fff
    classDef minor fill:#1a1a2a,stroke:#555,stroke-width:1px,color:#aaa
    classDef bridge fill:#3a2a1a,stroke:#daa520,stroke-width:1px,color:#fcd
    classDef out fill:none,stroke:#666,stroke-dasharray:3 3,color:#999
